
# Copy to .env for local development.

# PostgreSQL connection string.
DATABASE_URL=postgres://user:password@localhost:5432/primeutility

# Public website origin.
MYTHEX_WEB_ORIGIN=http://localhost:3000

# Optional database TLS settings.
# DATABASE_CA_CERT=
# DATABASE_SSL_NO_VERIFY=false

# Secret salt for hashing rate-limit keys.
RATE_LIMIT_SALT=replace-with-a-long-random-secret

# Security headers.
# X_FRAME_OPTIONS=SAMEORIGIN

# Comma-separated administrator email addresses.
# ADMIN_EMAILS=admin@example.com
